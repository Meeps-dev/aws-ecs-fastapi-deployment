aws_region     = "eu-west-2"
aws_account_id = "123456789012"

project_name = "aws-ecs-fastapi-deployment"
environment  = "dev"
owner        = "your-name"

github_owner         = "your-github-owner"
github_owner_id      = "12345678"
github_repository    = "aws-ecs-fastapi-deployment"
github_repository_id = "123456789"
github_branch        = "main"


vpc_cidr = "10.13.0.0/16"

availability_zones = [
  "eu-west-2a",
  "eu-west-2b"
]

public_subnet_cidrs = [
  "10.13.0.0/24",
  "10.13.1.0/24"
]

private_db_subnet_cidrs = [
  "10.13.10.0/24",
  "10.13.11.0/24"
]

application_port = 8000
database_port    = 5432
