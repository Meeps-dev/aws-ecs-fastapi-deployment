# Docker Compose local-development template
# Copy this file to .env.compose and replace the password.
# Never commit populated environment files.

POSTGRES_USER=meeps
POSTGRES_PASSWORD=replace_with_random_hex_value
POSTGRES_DB=users_posts
API_PORT=8000

# Inside the Compose network, the application connection is:
# postgresql://<user>:<password>@db:5432/<database>
#
# The compose.yaml file constructs DATABASE_URL from the values above.
